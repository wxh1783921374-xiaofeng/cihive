# GitHub App
CIHIVE_GITHUB_APP_ID=123456
CIHIVE_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
CIHIVE_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
CIHIVE_GITHUB_APP_SLUG=cihive

# Public URL of this control plane. It must be reachable by GitHub.
CIHIVE_CONTROL_PLANE_URL=https://cihive.example.com
CIHIVE_WORKFLOW_FILE=.github/workflows/cihive.yml
# Optional. When set, GET /v1/runs/{id} requires this bearer token.
CIHIVE_ADMIN_TOKEN=replace-with-a-separate-random-secret

# OpenAI model used for planning and repair. Override to match your account.
OPENAI_API_KEY=
CIHIVE_MODEL=gpt-6-astra
CIHIVE_MODEL_PROVIDER=openai

# Storage and safety limits
CIHIVE_DATA_DIR=/data
CIHIVE_DATABASE_PATH=/data/cihive.db
CIHIVE_MAX_WORKERS=3
CIHIVE_MAX_MODEL_TURNS=12
CIHIVE_RUN_TIMEOUT_SECONDS=1200
CIHIVE_MAX_PATCH_LINES=500
CIHIVE_MAX_PATCH_FILES=20
CIHIVE_MAX_CONTEXT_BYTES=2000000
CIHIVE_MAX_LOG_CHARS=200000
CIHIVE_MAX_LOG_BYTES=10000000
CIHIVE_MAX_WEBHOOK_BYTES=2000000

# Keep OIDC enabled in production. Disable only for isolated local testing.
CIHIVE_REQUIRE_OIDC=true
CIHIVE_GITHUB_OIDC_AUDIENCE=cihive
